@using Kriseportal.Web.Models.Entities
@model List<Request>

@{
    // Sara: Bruker ressursleverandørportalens egen layout.
    Layout = "_ResourceProviderLayout";
    ViewData["Title"] = "Dine forespørsler";

    // Sara: Beregner statistikk fra leverandørens egne forespørsler.
    var newRequests = Model.Count(r => r.Status == RequestStatus.Proposed);
    var confirmedRequests = Model.Count(r => r.Status == RequestStatus.Confirmed);

    // Sara: Filtrering skjer på siden uten å endre controller eller database.
    var filter = Context.Request.Query["filter"].ToString().ToLowerInvariant();
    var visibleRequests = filter switch
    {
        "new" => Model.Where(r => r.Status == RequestStatus.Proposed).ToList(),
        "confirmed" => Model.Where(r => r.Status == RequestStatus.Confirmed).ToList(),
        _ => Model
    };
    var sectionTitle = filter switch
    {
        "new" => "Nye forespørsler",
        "confirmed" => "Godkjente forespørsler",
        _ => "Alle forespørsler"
    };
}

<style>
    /* Sara: Styling for forespørselssiden. */
    .requests-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 12px 0 40px;
        color: #244D3B;
    }

    .requests-heading {
        margin-bottom: 28px;
    }

    .requests-heading h1 {
        font-size: 30px;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .requests-heading p {
        color: #68796E;
        margin: 0;
        font-size: 15px;
    }

    .requests-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 34px;
    }

    .requests-stat-card {
        display: block;
        background: #FFFFFF;
        border: 1px solid #DFE7DD;
        border-radius: 14px;
        padding: 24px;
        color: #244D3B;
        text-decoration: none;
        transition: border-color .15s, box-shadow .15s;
    }

    .requests-stat-card:hover, .requests-stat-card:focus-visible {
        border-color: #244D3B;
        box-shadow: 0 2px 12px rgba(36,77,59,.08);
        color: #244D3B;
    }

    .requests-stat-card.is-active {
        border: 2px solid #244D3B;
        padding: 23px;
    }

    .requests-stat-label {
        color: #68796E;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .requests-stat-number {
        font-size: 34px;
        font-weight: 700;
        line-height: 1;
    }

    .requests-filter-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .requests-filter-link {
        display: inline-block;
        padding: 9px 15px;
        border: 1px solid #DFE7DD;
        border-radius: 20px;
        color: #244D3B;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        background: #FFFFFF;
    }

    .requests-filter-link:hover {
        border-color: #244D3B;
        color: #244D3B;
    }

    .requests-filter-link.is-active {
        background: #244D3B;
        color: #FFFFFF;
        border-color: #244D3B;
    }

    .requests-section-title {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 18px;
    }

    .requests-list {
        display: grid;
        gap: 18px;
    }

    .request-card {
        background: #FFFFFF;
        border: 1px solid #DFE7DD;
        border-radius: 14px;
        padding: 24px;
    }

    .request-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .request-number {
        color: #68796E;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .4px;
    }

    .request-priority {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .priority-urgent {
        background: #FCE8E6;
        color: #B42318;
    }

    .priority-normal {
        background: #EDF2EA;
        color: #42634F;
    }

    .request-card h3 {
        font-size: 20px;
        margin: 0 0 8px;
        font-weight: 700;
    }

    .request-sender {
        color: #68796E;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .request-information {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 20px;
    }

    .request-info-label {
        color: #819087;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .request-info-value {
        color: #244D3B;
        font-size: 14px;
        font-weight: 600;
    }

    .request-card-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #E7ECE5;
        padding-top: 18px;
        flex-wrap: wrap;
    }

    .request-date {
        color: #68796E;
        font-size: 13px;
    }

    .request-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .request-answer-button {
        display: inline-block;
        background: #244D3B;
        color: #FFFFFF;
        text-decoration: none;
        border-radius: 8px;
        padding: 12px 18px;
        font-size: 14px;
        font-weight: 600;
    }

    .request-answer-button:hover {
        background: #183A2B;
        color: #FFFFFF;
    }

    .request-detail-link {
        color: #244D3B;
        font-size: 14px;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .request-detail-link:hover {
        color: #183A2B;
    }

    .request-status {
        display: inline-block;
        border-radius: 20px;
        padding: 8px 13px;
        font-size: 13px;
        font-weight: 600;
    }

    .request-status-confirmed {
        background: #E3F3E7;
        color: #246B3A;
    }

    .request-status-rejected {
        background: #F1F2F0;
        color: #68736B;
    }

    .requests-empty {
        background: #FFFFFF;
        border: 1px solid #DFE7DD;
        border-radius: 14px;
        padding: 48px 24px;
        text-align: center;
        color: #68796E;
    }

    .requests-empty h3 {
        color: #244D3B;
        margin: 0 0 10px;
    }

    @@media (max-width: 700px) {
        .requests-stats {
            grid-template-columns: 1fr;
        }

        .request-information {
            grid-template-columns: 1fr 1fr;
        }

        .request-card {
            padding: 18px;
        }

        .requests-heading h1 {
            font-size: 25px;
        }

    }
</style>

<div class="requests-page">
    <!-- Sara: Sidens overskrift. -->
    <div class="requests-heading">
        <h1>Dine forespørsler</h1>
        <p>Se og administrer forespørsler fra offentlige aktører om ressursene dine.</p>
    </div>

    <!-- Sara: Klikkbare statistikkort filtrerer forespørslene. -->
    <div class="requests-stats">
        <a class="requests-stat-card @(filter == "new" ? "is-active" : "")"
           asp-controller="ResourceProvider" asp-action="Requests" asp-route-filter="new">
            <div class="requests-stat-label">Nye forespørsler</div>
            <div class="requests-stat-number">@newRequests</div>
        </a>
        <a class="requests-stat-card @(filter == "confirmed" ? "is-active" : "")"
           asp-controller="ResourceProvider" asp-action="Requests" asp-route-filter="confirmed">
            <div class="requests-stat-label">Godkjente forespørsler</div>
            <div class="requests-stat-number">@confirmedRequests</div>
        </a>
    </div>

    <!-- Sara: Gir mulighet til å vise alle forespørsler igjen. -->
    <nav class="requests-filter-bar" aria-label="Filtrer forespørsler">
        <a class="requests-filter-link @(filter != "new" && filter != "confirmed" ? "is-active" : "")"
           asp-controller="ResourceProvider" asp-action="Requests">Alle</a>
        <a class="requests-filter-link @(filter == "new" ? "is-active" : "")"
           asp-controller="ResourceProvider" asp-action="Requests" asp-route-filter="new">Nye</a>
        <a class="requests-filter-link @(filter == "confirmed" ? "is-active" : "")"
           asp-controller="ResourceProvider" asp-action="Requests" asp-route-filter="confirmed">Godkjente</a>
    </nav>

    <h2 class="requests-section-title">@sectionTitle</h2>

    <div class="requests-list">
        @if (!visibleRequests.Any())
        {
            <!-- Sara: Tom tilstand for valgt filter. -->
            <div class="requests-empty">
                <h3>@(filter == "confirmed" ? "Ingen godkjente forespørsler ennå" : filter == "new" ? "Ingen nye forespørsler" : "Ingen forespørsler ennå")</h3>
                <p>@(filter == "confirmed" ? "Godkjente forespørsler vises her når de er behandlet." : filter == "new" ? "Du har ingen forespørsler som venter på svar." : "Her vil forespørsler fra offentlige aktører vises når de blir sendt til deg.")</p>
            </div>
        }
        else
        {
            @foreach (var request in visibleRequests)
            {
                var need = request.Match?.Need;
                var resource = request.Match?.Resource;
                // Sara: Prioritetsverdiene kommer fra behovet.
                var isUrgent = need != null && need.Priority != NeedPriority.Normal;
                // Sara: Bruker navnet fra den offentlige aktørens brukerkonto.
                var sender = need?.PublicAuthority?.Name ?? "Ukjent offentlig aktør";

                <div class="request-card">
                    <div class="request-card-top">
                        <span class="request-number">FORESPØRSEL #@request.RequestId</span>
                        <span class="request-priority @(isUrgent ? "priority-urgent" : "priority-normal")">
                            @(isUrgent ? "Haster" : "Normal prioritet")
                        </span>
                    </div>

                    <h3>@(need?.Title ?? "Forespørsel om ressurs")</h3>
                    <div class="request-sender">Fra: @sender</div>

                    <div class="request-information">
                        <div>
                            <div class="request-info-label">Ressurs</div>
                            <div class="request-info-value">@(resource?.Name ?? "Ukjent ressurs")</div>
                        </div>
                        <div>
                            <div class="request-info-label">Antall</div>
                            <div class="request-info-value">@request.Quantity @(need?.Unit ?? "stk")</div>
                        </div>
                        <div>
                            <div class="request-info-label">Kommune</div>
                            <div class="request-info-value">@(need?.Municipality ?? "Ikke oppgitt")</div>
                        </div>
                    </div>

                    <div class="request-card-bottom">
                        <span class="request-date">
                            Behov fra: @(need != null ? need.NeededFrom.ToString("dd.MM.yyyy") : "Ikke oppgitt")
                        </span>
                        <div class="request-actions">
                            @if (request.Status == RequestStatus.Proposed)
                            {
                                <!-- Sara: Åpner detaljsiden for akkurat denne forespørselen. -->
                                <a class="request-answer-button"
                                   asp-controller="ResourceProvider"
                                   asp-action="RequestDetails"
                                   asp-route-id="@request.RequestId">Svar på forespørsel →</a>
                            }
                            else if (request.Status == RequestStatus.Confirmed)
                            {
                                <span class="request-status request-status-confirmed">Godkjent</span>
                                <a class="request-detail-link"
                                   asp-controller="ResourceProvider" asp-action="RequestDetails"
                                   asp-route-id="@request.RequestId">Se detaljer →</a>
                            }
                            else if (request.Status == RequestStatus.Rejected)
                            {
                                <span class="request-status request-status-rejected">Avslått</span>
                                <a class="request-detail-link"
                                   asp-controller="ResourceProvider" asp-action="RequestDetails"
                                   asp-route-id="@request.RequestId">Se detaljer →</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
