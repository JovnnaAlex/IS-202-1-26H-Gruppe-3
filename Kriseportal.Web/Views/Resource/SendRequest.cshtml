
@model Kriseportal.Web.Models.ResourceRequestViewModel

@{
    ViewData["Title"] = "Send forespørsel";
}

<style>
    /* Sara: Design tilpasset ressursoversikten og Figma. */
    .request-page {
        color: #293B33;
        width: 100%;
        padding: 40px;
        box-sizing: border-box;
    }

    .request-back {
        display: inline-block;
        color: #527667;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 22px;
    }

    .request-back:hover {
        text-decoration: underline;
    }

    .request-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .request-subtitle {
        color: #8A6F5A;
        margin-bottom: 30px;
    }

    .request-card {
        background: #FFFFFF;
        border: 1px solid #E8E0D7;
        border-radius: 12px;
        padding: 28px;
        margin-bottom: 22px;
    }

    .request-card h2 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 22px;
    }

    .request-resource {
        background: #F0F3EF;
        border-radius: 9px;
        padding: 20px;
    }

    .request-resource-name {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .request-resource-info {
        color: #63766B;
        font-size: 14px;
        margin-bottom: 0;
    }

    .request-field {
        margin-bottom: 24px;
    }

    .request-label {
        display: block;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .request-hint {
        color: #8A6F5A;
        font-size: 13px;
        margin-top: 8px;
    }

    .request-input {
        display: block;
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #D7DED7;
        border-radius: 8px;
        background: #FFFFFF;
        color: #293B33;
        font: inherit;
    }

    .request-input:focus {
        outline: 2px solid #A8C4B0;
        outline-offset: 1px;
    }

    .request-status {
        display: inline-block;
        padding: 8px 15px;
        border-radius: 20px;
        background: #F3ECE3;
        color: #856A53;
        font-size: 13px;
        font-weight: 600;
    }

    .request-notice {
        padding: 16px 18px;
        border: 1px solid #E8E0D7;
        background: #FAF7F2;
        border-radius: 9px;
        color: #6C604F;
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .request-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        align-items: center;
    }

    .request-button {
        display: inline-block;
        border: none;
        border-radius: 8px;
        padding: 13px 24px;
        background: #527667;
        color: #FFFFFF;
        font-weight: 600;
        text-decoration: none;
    }

    .request-button:disabled {
        background: #A9B8AF;
        color: #FFFFFF;
        cursor: not-allowed;
    }

    .request-cancel {
        color: #527667;
        font-weight: 600;
        text-decoration: none;
    }

    .request-cancel:hover {
        text-decoration: underline;
    }

    @@media (max-width: 768px) {
        .request-page {
            padding: 20px;
        }

        .request-card {
            padding: 18px;
        }

        .request-title {
            font-size: 26px;
        }

        .request-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .request-button,
        .request-cancel {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="request-page">
    <a asp-controller="Resource"
       asp-action="Index"
       class="request-back">
        ← Tilbake til ressurser
    </a>

    <h1 class="request-title">Send forespørsel</h1>

    <p class="request-subtitle">
        Velg hvilket behov du ønsker å dekke med ressursen.
    </p>

    <section class="request-card">
        <h2>Valgt ressurs</h2>

        <div class="request-resource">
            <p class="request-resource-name">
                @Model.Resource.Name
            </p>

            <p class="request-resource-info">
                @Model.Resource.Municipality ·
                @Model.AvailableQuantity @Model.Resource.Unit ledig
                av totalt @Model.Resource.Quantity
            </p>
        </div>
    </section>

    <section class="request-card">
        <h2>Forespørselsinformasjon</h2>

        @if (Model.AvailableQuantity == 0)
        {
            <div class="request-notice" role="status">
                Ressursen har ingen ledige enheter.
            </div>
        }
        else if (Model.Needs.Count == 0)
        {
            <div class="request-notice" role="status">
                Du har ingen aktuelle behov i samme kategori.
                Behov som allerede er dekket, eller har en ventende
                eller bekreftet forespørsel til denne ressursen,
                vises ikke her.
            </div>

            <a asp-controller="Need"
               asp-action="Create"
               class="request-button">
                Registrer et behov
            </a>
        }
        else
        {
            <form asp-controller="Matching"
                  asp-action="SendRequest"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ResourceId"
                       value="@Model.Resource.ResourceId" />

                <div class="request-field">
                    <label for="needSelect" class="request-label">
                        Velg behov
                    </label>

                    <select id="needSelect"
                            name="NeedId"
                            class="request-input"
                            required>
                        <option value="">Velg et registrert behov</option>

                        @foreach (var need in Model.Needs)
                        {
                            <option value="@need.NeedId">
                                @need.Title — @need.Municipality
                            </option>
                        }
                    </select>
                </div>

                <div class="request-field">
                    <label for="requestQuantity" class="request-label">
                        Antall (@Model.Resource.Unit)
                    </label>

                    <input id="requestQuantity"
                           name="Quantity"
                           type="number"
                           class="request-input"
                           value="1"
                           min="1"
                           max="@Model.AvailableQuantity"
                           required />

                    <p class="request-hint">
                        Du kan spørre om opptil
                        @Model.AvailableQuantity @Model.Resource.Unit.
                        Antallet kontrolleres også mot det valgte
                        behovets gjenstående antall når du sender.
                    </p>
                </div>

                <div class="request-notice">
                    Forespørselen sendes til ressursleverandøren.
                    Antallet teller først mot behovet når
                    leverandøren har bekreftet.
                </div>

                <div class="request-actions">
                    <button type="submit" class="request-button">
                        Send forespørsel
                    </button>

                    <a asp-controller="Resource"
                       asp-action="Index"
                       class="request-cancel">
                        Avbryt
                    </a>
                </div>
            </form>
        }
    </section>
</div>