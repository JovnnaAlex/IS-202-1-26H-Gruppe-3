@{
    ViewData["Title"] = "Registrering bekreftet";
}

<div style="max-width: 650px; margin: 80px auto; text-align: center; padding: 40px;">

    <div style="font-size: 4rem; color: #244D3B;">
        ✓
    </div>

    <h1 style="color: #244D3B; margin-top: 20px;">
        Opplysningene er bekreftet!
    </h1>

    <p style="color: #66756B; font-size: 1.1rem; margin-top: 20px;">
        Du har kontrollert og bekreftet informasjonen om ressursen.
