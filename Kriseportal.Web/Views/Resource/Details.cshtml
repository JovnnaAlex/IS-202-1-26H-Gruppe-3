@model Kriseportal.Web.Models.ResourceViewModel
@using System.Globalization

@{
    // Setter sidetittelen.
    ViewData["Title"] = "Forhåndsvisning av ressurs";

    // Henter koordinatene og sørger for riktig desimalformat.
    var lat = Model.Latitude?.ToString(CultureInfo.InvariantCulture);
    var lng = Model.Longitude?.ToString(CultureInfo.InvariantCulture);

    @* Edgar la til ? for å håndtere mulige nullverdier i Latitude og Longitude. *@
}

@* Laster inn Leaflet og stilarket for detaljsiden. *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />

<main class="result" style="--accent:var(--c-resource)">

    @* Viser en forhåndsvisning av ressursinformasjonen. *@
    <div class="result__banner" role="status">
        <h1>Forhåndsvisning av ressurs</h1>
        <p>
            Opplysningene er kontrollert, men ressursen er ikke lagret ennå.
        </p>
    </div>

    <div class="result__grid">

        @* Viser informasjon om den registrerte ressursen. *@
        <dl class="result__facts">
            <dt>Navn</dt>
            <dd>@Model.Name</dd>
            @* Viser kommunen der ressursen befinner seg. *@
            <dt>Kommune</dt>
            <dd>@Model.Municipality</dd>
            @* Viser kontaktinformasjon for ressursen. *@
            <dt>Kontaktperson</dt>
            <dd>@Model.ContactName</dd>

            <dt>Telefonnummer</dt>
            <dd>@Model.ContactPhone</dd>
            @* Viser hvor mye av ressursen som tilbys. *@
            <dt>Antall</dt>
            <dd>@Model.Quantity @Model.Unit</dd>
            @* Viser navnet på ressurskategorien fra databasen. *@
            <dt>Ressurskategori</dt>
            <dd>@ViewBag.CategoryName</dd>
            <dt>Beskrivelse</dt>
            <dd>@Model.Description</dd>
            @* Viser perioden ressursen er tilgjengelig. *@
            <dt>Tilgjengelig fra</dt>
            <dd>
                @(Model.AvailableFrom?.ToString("dd.MM.yyyy") ?? "Ikke oppgitt")
            </dd>

            <dt>Tilgjengelig til</dt>
            <dd>
                @(Model.AvailableTo?.ToString("dd.MM.yyyy") ?? "Ikke oppgitt")
            </dd>
            @* Viser ressursens tilgjengelighetsstatus. *@
            <dt>Status</dt>
            <dd>
                <span class="badge @(Model.Availability == Kriseportal.Web.Models.Entities.ResourceAvailability.Available
                                       ? "badge--available"
                                       : "badge--unavailable")">
                    @(Model.Availability switch
                    {
                        Kriseportal.Web.Models.Entities.ResourceAvailability.Available => "Tilgjengelig",
                        Kriseportal.Web.Models.Entities.ResourceAvailability.Reserved => "Reservert",
                        Kriseportal.Web.Models.Entities.ResourceAvailability.Unavailable => "Ikke tilgjengelig",
                        _ => "Ukjent"
                    })
                </span>
            </dd>
        </dl>

        @* Viser kartet og koordinatene til ressursen. *@
        <section aria-label="Plassering på kart">
            <div id="map" class="result__map"></div>
            <p class="result__coords">Posisjon: @lat, @lng</p>
        </section>
    </div>

    @* Navigasjon fra forhåndsvisningen. *@
    <div class="result__actions">

        <form asp-controller="Resource"
              asp-action="EditPreview"
              method="post">

            @Html.AntiForgeryToken()

            @* Beholder informasjonen når brukeren går tilbake. *@
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="CategoryId" />
            <input type="hidden" asp-for="Description" />
            <input type="hidden" asp-for="Quantity" />
            <input type="hidden" asp-for="Unit" />
            <input type="hidden" asp-for="Availability" />
            <input type="hidden" asp-for="AvailableFrom" />
            <input type="hidden" asp-for="AvailableTo" />
            <input type="hidden" asp-for="Municipality" />
            <input type="hidden" asp-for="ContactName" />
            <input type="hidden" asp-for="ContactPhone" />
            <input type="hidden" asp-for="Latitude" />
            <input type="hidden" asp-for="Longitude" />

            <button type="submit" class="primary">
                Tilbake og rediger
            </button>

        </form>

        @* Bekrefter opplysningene og sender ressursinformasjonen videre. *@
        <form asp-controller="Resource"
              asp-action="ConfirmPreview"
              method="post">

            @Html.AntiForgeryToken()

            @* Informasjon om ressursen *@
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="CategoryId" />
            <input type="hidden" asp-for="Description" />
            <input type="hidden" asp-for="Quantity" />
            <input type="hidden" asp-for="Unit" />
            <input type="hidden" asp-for="Availability" />

            @* Tilgjengelighetsperiode *@
            <input type="hidden" asp-for="AvailableFrom" />
            <input type="hidden" asp-for="AvailableTo" />

            @* Plassering *@
            <input type="hidden" asp-for="Municipality" />
            <input type="hidden" asp-for="Latitude" />
            <input type="hidden" asp-for="Longitude" />

            @* Kontaktinformasjon *@
            <input type="hidden" asp-for="ContactName" />
            <input type="hidden" asp-for="ContactPhone" />

            <button type="submit" class="primary">
                Bekreft registrering
            </button>

        </form>

    </div>
</main>


@* Lagrer koordinatene i skjulte felt slik at JavaScript kan hente dem. *@
<input type="hidden" id="Latitude" value="@lat" />
<input type="hidden" id="Longitude" value="@lng" />

@section Scripts {

    @* Laster inn Leaflet-biblioteket. *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Henter koordinatene fra de skjulte feltene.
        const lat = parseFloat(document.getElementById("Latitude").value);
        const lng = parseFloat(document.getElementById("Longitude").value);

        // Oppretter kartet og sentrerer det på den registrerte ressursen.
        const map = L.map("map").setView([lat, lng], 13);

        // Legger til Kartverkets topografiske kartgrunnlag.
        L.tileLayer("https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png", {

            // Setter maksimalt zoomnivå til 18.
            maxZoom: 18,

            // Viser Kartverket som kilde på kartet.
            attribution: "&copy; Kartverket"

        }).addTo(map);

        // Plasserer en markør på ressursens registrerte posisjon.
        L.marker([lat, lng]).addTo(map);
    </script>
}