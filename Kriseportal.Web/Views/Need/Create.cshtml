@model Kriseportal.Web.Models.NeedViewModel

@{
    ViewData["Title"] = "Registrer behov";
}

<!-- Laster inn Leaflet sitt stilark for kartvisning. -->
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    /* Hovedområdet for registrering av behov. */
    .need-page {
        max-width: 1300px;
        margin: 0 auto;
        color: #24332B;
    }

    /* Overskrift og forklarende tekst. */
    .need-heading {
        margin-bottom: 28px;
    }

    .need-heading h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #244D3B;
        margin-bottom: 8px;
    }

    .need-heading p {
        color: #66756B;
        margin: 0;
    }

    /* Hvit boks rundt registreringsskjemaet. */
    .need-card {
        background-color: #FFFFFF;
        border: 1px solid #E1E8E1;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }

    /* Plasserer informasjon og kart ved siden av hverandre. */
    .need-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 36px;
    }

    /* Overskrifter for skjemadelene. */
    .need-section-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 24px;
        color: #244D3B;
    }

    /* Avstand mellom feltene. */
    .need-field {
        margin-bottom: 22px;
    }

    /* Etiketter for skjemafeltene. */
    .need-label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
    }

    /* Viser obligatoriske felt med en rød stjerne. */
    .required-star {
        color: #C62828;
        font-weight: 700;
    }

    /* Felles utseende for tekstfelt og nedtrekkslister. */
    .need-input {
        display: block;
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #CBD5CC;
        border-radius: 8px;
        background-color: #FFFFFF;
        color: #24332B;
        font: inherit;
    }

    /* Tydelig markering av aktive felt. */
    .need-input:focus {
        outline: 2px solid #244D3B;
        outline-offset: 1px;
    }

    /* Beskrivelsesfeltet skal ha god plass. */
    .need-textarea {
        min-height: 160px;
        resize: vertical;
    }

    /* Viser valideringsfeil under tilhørende felt. */
    .field-validation-error {
        display: block;
        color: #C62828;
        font-size: 0.9rem;
        margin-top: 6px;
    }

    /* Forklarende tekst ved kartet. */
    .need-help-text {
        color: #66756B;
        font-size: 0.95rem;
        margin-bottom: 14px;
    }

    /* Område for fremtidige adresseforslag. */
    #addressSuggestions {
        margin-top: 6px;
    }

    /* Kartets størrelse og ramme. */
    #map {
        height: 400px;
        width: 100%;
        border: 1px solid #CBD5CC;
        border-radius: 10px;
        z-index: 0;
    }

    /* Plasserer koordinatfeltene ved siden av hverandre. */
    .need-coordinates {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 20px;
    }

    /* Koordinatene fylles inn automatisk fra kartet. */
    .need-input[readonly] {
        background-color: #F5F7F4;
        color: #526157;
    }

    /* Plasserer registreringsknappen nederst til høyre. */
    .need-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid #E1E8E1;
    }

    /* Grønn hovedknapp for registrering. */
    .need-submit {
        background-color: #244D3B;
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        padding: 14px 28px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .need-submit:hover {
        background-color: #193A2C;
    }

    .need-submit:focus-visible {
        outline: 3px solid #86B69A;
        outline-offset: 3px;
    }

    /* Tilpasser skjemaet til mindre skjermer. */
    @@media (max-width: 900px) {
        .need-grid {
            grid-template-columns: 1fr;
        }

        .need-card {
            padding: 20px;
        }

        .need-coordinates {
            grid-template-columns: 1fr;
        }

        .need-submit {
            width: 100%;
        }
    }
</style>

<!-- Hovedinnhold for registrering av behov. -->
<div class="need-page">

    <!-- Sidens overskrift. -->
    <div class="need-heading">
        <h1>Registrer behov</h1>
        <p>
            Beskriv behovet og velg hvor det er behov for hjelp.
        </p>
    </div>

    <!-- Registreringsskjemaet. -->
    <div class="need-card">

        <form asp-controller="Need"
              asp-action="Create"
              method="post">

            <div class="need-grid">

                <!-- Venstre kolonne: Informasjon om behovet. -->
                <section>

                    <h2 class="need-section-title">
                        Informasjon om behovet
                    </h2>
                    
                    <!-- Tittel på behovet. -->
                    <div class="need-field">

                        <label asp-for="Title" class="need-label">
                            Tittel
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="Title"
                               class="need-input"
                               placeholder="F.eks. Behov for strømaggregat"
                               maxlength="150"
                               aria-required="true" />

                        <span asp-validation-for="Title"></span>

                    </div>
                    
                    <!-- Kategori for behovet. -->
                    <div class="need-field">

                        <label asp-for="CategoryId" class="need-label">
                            Kategori
                            <span class="required-star">*</span>
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="need-input"
                                aria-required="true">

                            <option value="0">Velg kategori</option>

                        </select>

                        <span asp-validation-for="CategoryId"></span>

                    </div>
                    <!-- Antall ressurser som trengs. -->
                    <div class="need-field">
                        <label asp-for="Quantity" class="need-label">
                            Antall
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               class="need-input"
                               min="1"
                               step="1"
                               aria-required="true" />

                        <span asp-validation-for="Quantity"></span>
                    </div>
                    
                    <!-- Velg måleenhet for antallet. -->
                    <div class="need-field">
                        <label asp-for="Unit" class="need-label">
                            Måleenhet
                            <span class="required-star">*</span>
                        </label>

                        <select asp-for="Unit" class="need-input" aria-required="true">
                            <option value="">Velg måleenhet</option>
                            <option value="stk">Stykk (stk)</option>
                            <option value="liter">Liter (L)</option>
                            <option value="kg">Kilogram (kg)</option>
                            <option value="tonn">Tonn</option>
                            <option value="meter">Meter (m)</option>
                            <option value="m²">Kvadratmeter (m²)</option>
                            <option value="timer">Timer</option>
                            <option value="personer">Personer</option>
                            <option value="plasser">Plasser</option>
                        </select>

                        <span asp-validation-for="Unit"></span>
                    </div>
                    
                    @* Tidspunktet behovet starter. *@
                    <div class="need-field">
                        <label asp-for="NeededFrom" class="need-label">
                            Behov fra
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="NeededFrom"
                               type="datetime-local"
                               class="need-input"
                               required />

                        <span asp-validation-for="NeededFrom"></span>
                    </div>

                    @* Tidspunktet behovet eventuelt avsluttes. *@
                    <div class="need-field">
                        <label asp-for="NeededTo" class="need-label">
                            Behov til (valgfritt)
                        </label>

                        <input asp-for="NeededTo"
                               type="datetime-local"
                               class="need-input" />

                        <span asp-validation-for="NeededTo"></span>
                    </div>
                    
                    <!-- Beskrivelse av behovet. -->
                    <div class="need-field">

                        <label asp-for="Description" class="need-label">
                            Beskrivelse
                            <span class="required-star">*</span>
                        </label>

                        <textarea asp-for="Description"
                                  class="need-input need-textarea"
                                  placeholder="Beskriv hva dere trenger, og hvorfor behovet har oppstått."
                                  aria-required="true"></textarea>

                        <span asp-validation-for="Description"></span>

                    </div>

                    <!-- Prioritet for behovet. -->
                    <div class="need-field">

                        <label asp-for="Priority" class="need-label">
                            Prioritet
                            <span class="required-star">*</span>
                        </label>

                        <select asp-for="Priority"
                                class="need-input"
                                aria-required="true">

                            <option value="">Velg prioritet</option>
                            <option value="Acute">Akutt</option>
                            <option value="High">Høy</option>
                            <option value="Normal">Normal</option>
                            <option value="Planned">Planlagt</option>

                        </select>

                        <span asp-validation-for="Priority"></span>

                    </div>

                </section>

                <!-- Høyre kolonne: Adresse, kart og koordinater. -->
                <section>

                    <!-- Kontaktinformasjon for behovet. -->
                    <h2 class="need-section-title">
                        Kontaktinformasjon
                    </h2>

                    <!-- Søk og velg kommune. -->
                    <div class="need-field">

                        <label asp-for="Municipality" class="need-label">
                            Kommune
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="Municipality"
                               class="need-input"
                               list="municipalityOptions"
                               placeholder="Søk etter kommune"
                               autocomplete="off"
                               maxlength="100"
                               aria-required="true" />

                        <!-- Kommunealternativene lastes fra kommuner.json. -->
                        <datalist id="municipalityOptions"></datalist>

                        <span asp-validation-for="Municipality"></span>

                    </div>
                    
                    <!-- Kontaktperson for behovet. -->
                    <div class="need-field">

                        <label asp-for="ContactName" class="need-label">
                            Kontaktperson
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="ContactName"
                               class="need-input"
                               placeholder="F.eks. Ola Nordmann"
                               maxlength="100"
                               aria-required="true" />

                        <span asp-validation-for="ContactName"></span>

                    </div>
                    
                    <!-- Telefonnummer til kontaktpersonen. -->
                    <div class="need-field">

                        <label asp-for="ContactPhone" class="need-label">
                            Telefonnummer
                            <span class="required-star">*</span>
                        </label>

                        <input asp-for="ContactPhone"
                               type="tel"
                               class="need-input"
                               placeholder="F.eks. +47 123 45 678"
                               maxlength="20"
                               autocomplete="tel"
                               aria-required="true" />

                        <span asp-validation-for="ContactPhone"></span>

                    </div>
                    
                    <h2 class="need-section-title">
                        Geografisk plassering
                        <span class="required-star">*</span>
                    </h2>

                    <!-- Adressefeltet kobles til Kartverkets API senere. -->
                    <div class="need-field">

                        <label for="addressSearch" class="need-label">
                            Søk etter adresse eller sted
                        </label>

                        <input type="search"
                               id="addressSearch"
                               class="need-input"
                               placeholder="F.eks. Markens gate 1, Kristiansand"
                               autocomplete="off" />

                        <!-- Her skal adresseforslag vises. -->
                        <div id="addressSuggestions"></div>

                    </div>

                    <!-- Forklaring av hvordan plassering velges. -->
                    <p class="need-help-text">
                        Søk etter en adresse, eller klikk direkte i kartet
                        for å velge plassering.
                    </p>

                    <!-- Kartverket-kartet opprettes av map.js. -->
                    <div id="map"
                         data-map-mode="edit"
                         aria-label="Kart for valg av geografisk plassering">
                    </div>

                    <!-- Koordinatene fylles inn automatisk fra kartet. -->
                    <div class="need-coordinates">

                        <!-- Breddegrad. -->
                        <div>

                            <label asp-for="Latitude" class="need-label">
                                Breddegrad
                            </label>

                            <input asp-for="Latitude"
                                   class="need-input"
                                   readonly />

                            <span asp-validation-for="Latitude"></span>

                        </div>

                        <!-- Lengdegrad. -->
                        <div>

                            <label asp-for="Longitude" class="need-label">
                                Lengdegrad
                            </label>

                            <input asp-for="Longitude"
                                   class="need-input"
                                   readonly />

                            <span asp-validation-for="Longitude"></span>

                        </div>

                    </div>

                </section>

            </div>

            <!-- Knapp for å sende inn registreringen. -->
            <div class="need-actions">

                <button type="submit" class="need-submit">
                    Registrer behov
                </button>

            </div>

        </form>

    </div>

</div>

<!-- Laster inn Leaflet og eksisterende kartfunksjonalitet. -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/map.js" asp-append-version="true"></script>

<script>
    // Henter norske kommunenavn fra den lokale JSON-filen.
    async function loadMunicipalities() {
        try {
            const response = await fetch('/data/kommuner.json');

            if (!response.ok) {
                throw new Error('Kunne ikke hente kommunelisten.');
            }

            const municipalities = await response.json();
            const datalist = document.getElementById('municipalityOptions');

            // Lager et søkeforslag for hver kommune.
            municipalities.forEach(municipality => {
                const option = document.createElement('option');
                option.value = municipality;
                datalist.appendChild(option);
            });
        } catch (error) {
            console.error('Feil ved lasting av kommuner:', error);
        }
    }

    // Laster kommunene når siden åpnes.
    loadMunicipalities();
</script>