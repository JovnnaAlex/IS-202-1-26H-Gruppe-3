@model Kriseportal.Web.Models.NeedViewModel

@{
    ViewData["Title"] = "Registrer behov";
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet"
          href="~/css/need-create.css"
          asp-append-version="true" />
}

<div class="need-create-page">

    <!-- Sideoverskrift fra Figma -->
    <header class="need-create-header">
        <h1>Registrer behov</h1>
        <p>Registrer et nytt behov for ressurser</p>
    </header>

    <!-- Hvitt skjemakort -->
    <section class="need-create-card">

        <form asp-controller="Need"
              asp-action="Create"
              method="post"
              class="need-create-form">

            <div asp-validation-summary="ModelOnly"></div>

            <!-- Alle feltene fra Figma -->
            <div class="need-create-grid">

                <h2 class="need-create-fields-heading">
                    Informasjon om behov
                </h2>

                <!-- Tittel på behov -->
                <div class="need-create-field need-create-title">
                    <label asp-for="Type">
                        Tittel på behov *
                    </label>

                    <input asp-for="Type"
                           class="need-create-input"
                           placeholder="f.eks. Aggregat til evakueringssenter" />

                    <span asp-validation-for="Type"></span>
                </div>

                <!-- Beskrivelse -->
                <div class="need-create-field need-create-description">
                    <label asp-for="Description">
                        Beskrivelse *
                    </label>

                    <textarea asp-for="Description"
                              class="need-create-textarea"
                              placeholder="Beskriv behovet nærmere..."></textarea>

                    <span asp-validation-for="Description"></span>
                </div>

                <!-- Kategori -->
                <div class="need-create-field need-create-category">
                    <label asp-for="Category">
                        Kategori *
                    </label>

                    <select asp-for="Category"
                            id="needCategory"
                            class="need-create-select">
                        <option value="">Velg kategori</option>
                        <option value="Utstyr">Utstyr</option>
                        <option value="Transport">Transport</option>
                        <option value="Personell">Personell</option>
                        <option value="Annet">Annet</option>
                    </select>

                    <span asp-validation-for="Category"></span>
                </div>

                <!-- Prioritet -->
                <div class="need-create-field need-create-priority">
                    <label asp-for="Priority">
                        Prioritet *
                    </label>

                    <select asp-for="Priority"
                            class="need-create-select">
                        <option value="">Velg prioritet</option>
                        <option value="Low">Lav</option>
                        <option value="Medium">Middels</option>
                        <option value="High">Høy</option>
                    </select>

                    <span asp-validation-for="Priority"></span>
                </div>

                
                <!-- Kommune -->
                <div class="need-create-field need-create-municipality">
                    <label asp-for="Municipality">
                        Kommune *
                    </label>

                    <select asp-for="Municipality"
                            id="needMunicipality"
                            class="need-create-select">
                        <option value="">Velg kommune</option>
                        <option value="Kristiansand">Kristiansand</option>
                        <option value="Vennesla">Vennesla</option>
                        <option value="Grimstad">Grimstad</option>
                    </select>

                    <span asp-validation-for="Municipality"></span>
                </div>

                <!-- Behov fra -->
                <div class="need-create-field need-create-date-from">
                    <label asp-for="NeedFrom">
                        Behov fra *
                    </label>

                    <input asp-for="NeedFrom"
                           type="datetime-local"
                           id="needDateFrom"
                           class="need-create-input" />

                    <span asp-validation-for="NeedFrom"></span>
                </div>

                <!-- Behov til -->
                <div class="need-create-field need-create-date-to">
                    <label asp-for="NeedTo">
                        Behov til *
                    </label>

                    <input asp-for="NeedTo"
                           type="datetime-local"
                           id="needDateTo"
                           class="need-create-input" />

                    <span asp-validation-for="NeedTo"></span>
                </div>

            </div> <!-- Lukker need-create-grid -->
            <!-- Kart som tillegg til Figma -->
            <section class="need-create-map-section">

                <h3>Geografisk plassering</h3>

                <p class="need-create-map-help">
                    Søk etter en adresse eller klikk i kartet
                    for å velge plassering.
                </p>

                <div class="need-create-field need-create-address">
                    <label for="addressSearch">
                        Søk etter adresse eller sted
                    </label>

                    <input type="search"
                           id="addressSearch"
                           class="need-create-input"
                           placeholder="f.eks. Markens gate 1, Kristiansand"
                           autocomplete="off" />

                    <div id="addressSuggestions"></div>
                </div>

                <!-- Leaflet -->
                <div id="map"
                     data-map-mode="edit"
                     aria-label="Kart for valg av geografisk plassering">
                </div>

                <!-- Koordinater fra kartet -->
                <div class="need-create-coordinates">

                    <div class="need-create-field">
                        <label asp-for="Latitude">
                            Breddegrad
                        </label>

                        <input asp-for="Latitude"
                               class="need-create-input"
                               readonly />

                        <span asp-validation-for="Latitude"></span>
                    </div>

                    <div class="need-create-field">
                        <label asp-for="Longitude">
                            Lengdegrad
                        </label>

                        <input asp-for="Longitude"
                               class="need-create-input"
                               readonly />

                        <span asp-validation-for="Longitude"></span>
                    </div>

                </div>

            </section>

            <!-- Knapper -->
            <div class="need-create-actions">

                <a asp-controller="Need"
                   asp-action="Index"
                   class="need-create-cancel">
                    Avbryt
                </a>

                <button type="submit"
                        class="need-create-submit">
                    Registrer behov
                </button>

            </div>

        </form>

    </section>

</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Gjør hele datofeltene klikkbare
        document.querySelectorAll(
            '#needDateFrom, #needDateTo'
        ).forEach(input => {

            input.addEventListener('click', function () {
                if (typeof this.showPicker === 'function') {
                    try {
                        this.showPicker();
                    } catch (error) {
                        this.focus();
                    }
                }
            });

        });
    </script>
}
