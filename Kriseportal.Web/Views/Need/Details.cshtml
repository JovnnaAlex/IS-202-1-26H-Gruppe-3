@model Kriseportal.Web.Models.NeedViewModel
@using System.Globalization
@using Kriseportal.Web.Models.Entities

@{
    // Setter sidetittelen.
    var isExisting = ViewData["ExistingNeed"] is true;

    ViewData["Title"] = isExisting
        ? "Behovsdetaljer"
        : "Behov registrert";

    // Henter koordinatene og sørger for riktig desimalformat.
    var lat = Model.Latitude?.ToString(CultureInfo.InvariantCulture);
    var lng = Model.Longitude?.ToString(CultureInfo.InvariantCulture);

    @* Edgar la til ? for å håndtere mulige nullverdier i Latitude og Longitude. *@

    // Bestemmer prioritet og tilhørende farge.
    var prio = Model.Priority switch
    {
        "Acute" => "high",
        "High" => "high",
        "Normal" => "medium",
        "Planned" => "low",
        _ => "low"
    };

    var accent = Model.Priority is "Acute" or "High"
        ? "var(--c-urgent)"
        : "var(--c-planned)";
}

@* Laster inn Leaflet og stilarket for detaljsiden. *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/need-details.css" asp-append-version="true" />

@{
    // Status fra databasen.
    // Nye registreringer har status New.
    var status = ViewData["NeedStatus"]?.ToString() ?? "New";

    var statusText = status switch
    {
        "New" => "Ny",
        "UnderReview" => "Vurderes",
        "Assigned" => "Tildelt",
        "Resolved" => "Løst",
        _ => status
    };

    var priorityText = Model.Priority switch
    {
        "Acute" => "Akutt",
        "High" => "Høy",
        "Normal" => "Normal",
        "Planned" => "Planlagt",
        _ => Model.Priority
    };

    // B13: neste status i flyten (null når behovet er løst)
    var nextStatus = ViewData["NextStatus"] as NeedStatus?;
}

<div class="nd-page">

    @* Bekreftelse vises kun etter registrering *@
    @if (!isExisting)
    {
        <div class="nd-confirmation" role="status">
            Behovet er registrert
        </div>
    }

    @* B13: melding etter statusendring *@
    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="nd-confirmation" role="status">
            @statusMessage
        </div>
    }

    @if (TempData["StatusError"] is string statusError)
    {
        <div class="nd-error" role="alert">
            @statusError
        </div>
    }

    <!-- Tilbake til behovsoversikten -->
    <a asp-controller="Need"
       asp-action="Index"
       class="nd-back">
        ← Tilbake til behov
    </a>

    <!-- Tittel, kommune, prioritet og status -->
    <div class="nd-heading">
        <div>
            <h1>@Model.Title</h1>
            <p>Behovsdetaljer · @Model.Municipality</p>
        </div>

        <div class="nd-badges">

            <span class="nd-badge nd-priority-@(Model.Priority.ToLowerInvariant())">
                @priorityText
            </span>

            <span class="nd-badge nd-status-@(status.ToLowerInvariant())">
                @statusText
            </span>

        </div>
    </div>

    <!-- Informasjon om behovet -->
    <section class="nd-card">

        <h2>Informasjon om behovet</h2>

        <div class="nd-grid">

            <div>
                <span class="nd-label">Kategori</span>
                <strong>@(Model.CategoryName ?? "Ukjent")</strong>
            </div>

            <div>
                <span class="nd-label">Kommune</span>
                <strong>@Model.Municipality</strong>
            </div>

            <div>
                <span class="nd-label">Antall</span>
                <strong>@Model.Quantity @Model.Unit</strong>
            </div>

            <div>
                <span class="nd-label">Status</span>
                <strong>@statusText</strong>
            </div>

            <div>
                <span class="nd-label">Behov fra</span>
                <strong>
                    @(Model.NeededFrom?.ToString("dd.MM.yyyy HH:mm")
                        ?? "Ikke spesifisert")
                </strong>
            </div>

            <div>
                <span class="nd-label">Behov til</span>
                <strong>
                    @(Model.NeededTo?.ToString("dd.MM.yyyy HH:mm")
                        ?? "Ikke spesifisert")
                </strong>
            </div>

        </div>
    </section>

    <!-- Beskrivelse -->
    <section class="nd-card">

        <h2>Beskrivelse</h2>

        <p class="nd-description">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "Ingen beskrivelse er registrert."
                : Model.Description)
        </p>

    </section>

    <!-- Kart -->
    <section class="nd-card">

        <h2>Behovets plassering</h2>

        <div id="map" class="nd-map"></div>

        <p class="nd-coordinates">
            Koordinater: @lat, @lng
        </p>

    </section>

    <!-- Kontaktinformasjon -->
    <section class="nd-card">

        <h2>Kontaktinformasjon</h2>

        <div class="nd-grid">

            <div>
                <span class="nd-label">Kontaktperson</span>
                <strong>@Model.ContactName</strong>
            </div>

            <div>
                <span class="nd-label">Telefonnummer</span>
                <a href="tel:@Model.ContactPhone"
                   class="nd-phone">
                    @Model.ContactPhone
                </a>
            </div>

        </div>
    </section>

    <!-- Lenke til tilgjengelige ressurser -->
    <div class="nd-actions">

        @* B13: flytter behovet ett steg fram i statusflyten *@
        @if (isExisting && nextStatus is not null)
        {
            <form asp-controller="Need"
                  asp-action="ChangeStatus"
                  method="post"
                  class="nd-status-form">
                <input type="hidden" name="id" value="@ViewData["NeedId"]" />
                <input type="hidden" name="newStatus" value="@nextStatus" />

                <button type="submit" class="nd-button nd-button-secondary">
                    Endre status til @NeedStatusFlow.DisplayName(nextStatus.Value)
                </button>
            </form>
        }

        <a asp-controller="Resource"
           asp-action="Index"
           class="nd-button">
            Se tilgjengelige ressurser
        </a>

    </div>
</div>

@* Lagrer koordinatene i skjulte felt slik at JavaScript kan hente dem. *@
<input type="hidden" id="Latitude" value="@lat" />
<input type="hidden" id="Longitude" value="@lng" />

@section Scripts {

    @* Laster inn Leaflet-biblioteket. *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Henter koordinatene fra de skjulte feltene.
        const lat = parseFloat(document.getElementById("Latitude").value);
        const lng = parseFloat(document.getElementById("Longitude").value);

        // Oppretter kartet og sentrerer det på det registrerte behovet.
        const map = L.map("map").setView([lat, lng], 13);

        // Legger til Kartverkets topografiske kartgrunnlag.
        L.tileLayer("https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png", {

            // Setter maksimalt zoomnivå.
            maxZoom: 18,

            // Viser Kartverket som kilde på kartet.
            attribution: "&copy; Kartverket"

        }).addTo(map);

        // Plasserer en markør på det registrerte behovets posisjon.
        L.marker([lat, lng]).addTo(map);
    </script>
}