@model Kriseportal.Web.Models.NeedViewModel
@using System.Globalization

@{
    // Setter sidetittelen.
    ViewData["Title"] = "Behov registrert";

    // Henter koordinatene og sørger for riktig desimalformat.
    var lat = Model.Latitude?.ToString(CultureInfo.InvariantCulture);
    var lng = Model.Longitude?.ToString(CultureInfo.InvariantCulture);

    @* Edgar la til ? for å håndtere mulige nullverdier i Latitude og Longitude. *@

    // Bestemmer prioritet og tilhørende farge.
    var prio = Model.Priority switch { "Høy" => "high", "Medium" => "medium", _ => "low" };
    var accent = Model.Priority == "Høy" ? "var(--c-urgent)" : "var(--c-planned)";
}

@* Laster inn Leaflet og stilarket for detaljsiden. *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />

<main class="result" style="--accent:@accent">

    @* Viser bekreftelse på at behovet er registrert. *@
    <div class="result__banner" role="status">
        <h1>Behovet er registrert</h1>
    </div>

    <div class="result__grid">

        @* Viser informasjon om det registrerte behovet. *@
        <dl class="result__facts">
            <dt>Type behov</dt>
            <dd>@Model.Type</dd>
            <dt>Prioritet</dt>
            <dd><span class="badge badge--@prio">@Model.Priority</span></dd>
            <dt>Beskrivelse</dt>
            <dd>@Model.Description</dd>
        </dl>

        @* Viser kartet og koordinatene til behovet. *@
        <section aria-label="Plassering på kart">
            <div id="map" class="result__map"></div>
            <p class="result__coords">Posisjon: @lat, @lng</p>
        </section>
    </div>

    @* Lenker for å registrere et nytt behov eller gå tilbake til forsiden. *@
    <div class="result__actions">
        <a class="primary" asp-controller="Need" asp-action="Create">Registrer nytt behov</a>
        <a asp-controller="Home" asp-action="Index">Til forsiden</a>
    </div>
</main>

@* Lagrer koordinatene i skjulte felt slik at JavaScript kan hente dem. *@
<input type="hidden" id="Latitude" value="@lat" />
<input type="hidden" id="Longitude" value="@lng" />

@section Scripts {

    @* Laster inn Leaflet-biblioteket. *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Henter koordinatene fra de skjulte feltene.
        const lat = parseFloat(document.getElementById("Latitude").value);
        const lng = parseFloat(document.getElementById("Longitude").value);

        // Oppretter kartet og sentrerer det på det registrerte behovet.
        const map = L.map("map").setView([lat, lng], 13);

        // Legger til Kartverkets topografiske kartgrunnlag.
        L.tileLayer("https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png", {

            // Setter maksimalt zoomnivå.
            maxZoom: 18,

            // Viser Kartverket som kilde på kartet.
            attribution: "&copy; Kartverket"

        }).addTo(map);

        // Plasserer en markør på det registrerte behovets posisjon.
        L.marker([lat, lng]).addTo(map);
    </script>
}