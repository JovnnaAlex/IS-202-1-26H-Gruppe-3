@{
    // Finner hvilken controller brukeren befinner seg på
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="no">

 <!--Legger til kompatibilitet for bootstrap, men ødelegger heller ikke site.css design-->
 <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>@ViewData["Title"] - Kriseportalen</title>

        <!-- Bootstrap fra master -->
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

        <!-- Vårt eget Figma-design -->
        <link rel="stylesheet"
              href="~/css/site.css"
              asp-append-version="true" />
</head>
<body>

    <div class="app-layout">

        <!-- Felles sidemeny som er felles på alle sider  -->
        <!-- Sider som fungerer -->
        <aside class="sidebar">

            <!-- Logo og undertekst fra Figma -->
            <div class="sidebar-brand">
                <h2>Kriseportalen</h2>
                <p>Ressurs - og behovskoordinering</p>
            </div>

            <nav class="sidebar-nav" aria-label="Hovedmeny">

                <!-- Dashboard -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(currentController == "Home" ? "active" : "")">

                    <img src="~/icons/dashboard.svg" alt="" class="sidebar-icon" />
                    Dashboard
                </a>

                <!-- Behov -->
                <a asp-controller="Need"
                   asp-action="Create"
                   class="@(currentController == "Need" ? "active" : "")">

                    <img src="~/icons/behov.svg" alt="" class="sidebar-icon" />
                    Behov
                </a>

                <!-- Ressurser -->
                <a asp-controller="Resource"
                   asp-action="Create"
                   class="@(currentController == "Resource" ? "active" : "")">

                    <img src="~/icons/ressurser.svg" alt="" class="sidebar-icon" />
                    Ressurser
                </a>

                <!-- Nederste meny, disse er heller ikke klare ennå/implementert -->
                <!--Forespørsler-->
                <!-- Kart-->
                <span class="sidebar-link disabled" aria-disabled="true">
                    <img src="~/icons/kart.svg"
                         alt=""
                         class="sidebar-icon" />
                    Kart
                </span>

                <span class="sidebar-link disabled">
                    <img src="~/icons/foresporsler.svg"
                         alt=""
                         class="sidebar-icon" />
                    Forespørsler
                </span>

            </nav>
    

            <div class="sidebar-bottom">

                <!--Innstillinger-->
                <span class="sidebar-link disabled">
                    <img src="~/icons/innstillinger.svg"
                         alt=""
                         class="sidebar-icon" />
                    Innstillinger
                </span>

                <!--Profil-->
                <span class="sidebar-link disabled">
                    <img src="~/icons/profil.svg"
                         alt=""
                         class="sidebar-icon" />
                    Min profil
                </span>

                <!--Logg-ut-->
                <span class="sidebar-link disabled">
                    <img src="~/icons/logg-ut.svg"
                         alt=""
                         class="sidebar-icon" />
                    Logg ut
                </span>

            </div>


        </aside>

        <!-- Innholdet på den aktive siden -->
        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>