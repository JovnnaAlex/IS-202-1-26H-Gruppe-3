
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Kriseportalen</title>

    <!-- Inter-font -->
    <link rel="preload"
          href="@Url.Content("~/fonts/InterVariable.woff2")"
          as="font"
          type="font/woff2"
          crossorigin />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Felles Figma-design -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- CSS for individuelle sider -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-layout">

        <aside class="sidebar">

            <!-- Logo -->
            <div class="sidebar-brand">
                <h2>Kriseportalen</h2>
                <p>Ressurs - og behovskoordinering</p>
            </div>

            <!-- Hovedmeny -->
            <nav class="sidebar-nav" aria-label="Hovedmeny">

                <!-- Dashboard -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(currentController == "Home" ? "active" : "")">

                    <img src="~/icons/dashboard.svg"
                         alt="" class="sidebar-icon" />
                    Dashboard
                </a>

                <!-- Behov -->
                <a asp-controller="Need"
                   asp-action="Index"
                   class="@(currentController == "Need" ? "active" : "")">

                    <img src="~/icons/behov.svg"
                         alt="" class="sidebar-icon" />
                    Behov
                </a>

                <!-- Ressurser -->
                <a asp-controller="Resource"
                   asp-action="Index"
                   class="@(currentController == "Resource" ? "active" : "")">

                    <img src="~/icons/ressurser.svg"
                         alt="" class="sidebar-icon" />
                    Ressurser
                </a>

                <!-- Kart: Ny funksjon fra master -->
                <a asp-controller="Map"
                   asp-action="Index"
                   class="@(currentController == "Map" ? "active" : "")">

                    <img src="~/icons/kart.svg"
                         alt="" class="sidebar-icon" />
                    Kart
                </a>

                <!-- Forespørsler: Ikke implementert -->
                <span class="sidebar-link disabled"
                      aria-disabled="true">

                    <img src="~/icons/foresporsler.svg"
                         alt="" class="sidebar-icon" />
                    Forespørsler
                </span>

            </nav>

            <!-- Nederste meny -->
            <div class="sidebar-bottom">

                <!-- Innstillinger -->
                <a asp-controller="Settings"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Settings" ? "active" : "")">

                    <img src="~/icons/innstillinger.svg"
                         alt="" class="sidebar-icon" />
                    Innstillinger
                </a>

                <!-- Min profil -->
                <a asp-controller="Profile"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Profile" ? "active" : "")">

                    <img src="~/icons/profil.svg"
                         alt="" class="sidebar-icon" />
                    Min profil
                </a>

                <!-- Innlogging og utlogging fra master -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="sidebar-link sidebar-logout-button">

                            <img src="~/icons/logg-ut.svg"
                                 alt="" class="sidebar-icon" />
                            Logg ut
                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="sidebar-link">
                        Logg inn
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="sidebar-link">
                        Opprett konto
                    </a>
                }

            </div> <!-- sidebar-bottom -->

        </aside> <!-- sidebar -->

        <!-- Sideinnhold -->
        <main class="main-content">
            @RenderBody()
        </main>

    </div> <!-- app-layout -->

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
