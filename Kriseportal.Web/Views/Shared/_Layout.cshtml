@{
    // Henter navnet på controlleren for å markere riktig menyvalg.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Kriseportal</title>

    <!-- Laster inn Bootstrap for responsivt oppsett. -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        /* Felles farger for Kriseportalen. */
        :root {
            --primary-green: #244D3B;
            --light-green: #EAF1EB;
            --background: #F5F7F4;
            --text-color: #24332B;
        }

        /* Grunnleggende utseende for hele nettsiden. */
        body {
            margin: 0;
            background-color: var(--background);
            color: var(--text-color);
            font-family: Arial, sans-serif;
        }

        /* Hovedoppsett med sidemeny og innhold. */
        .app-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidemenyen til venstre. */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: white;
            border-right: 1px solid #E1E8E1;
            padding: 24px 16px;
        }

        /* Navnet på portalen. */
        .sidebar-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-green);
            margin-bottom: 36px;
            padding-left: 12px;
        }

        /* Navigasjonslenkene. */
        .sidebar-link {
            display: block;
            padding: 12px 16px;
            margin-bottom: 6px;
            border-radius: 8px;
            color: var(--text-color);
            text-decoration: none;
            font-weight: 500;
        }

        /* Viser hvilket menyvalg brukeren holder over. */
        .sidebar-link:hover {
            background-color: var(--light-green);
            color: var(--primary-green);
        }

        /* Marker aktiv side i menyen. */
        .sidebar-link.active {
            background-color: var(--light-green);
            color: var(--primary-green);
            font-weight: 700;
            border-left: 4px solid var(--primary-green);
        }

        /* Menyvalg som ikke er implementert ennå. */
        .sidebar-link.disabled {
            color: #888;
            cursor: not-allowed;
            opacity: 0.6;
        }

        /* Området der hver side viser sitt innhold. */
        .main-content {
            flex: 1;
            min-width: 0;
            padding: 32px;
        }

        /* Tilpasser oppsettet til mindre skjermer. */
        @@media (max-width: 768px) {
            .app-layout {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid #E1E8E1;
                padding: 16px;
            }

            .sidebar-brand {
                margin-bottom: 16px;
            }

            .sidebar-nav {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
            }

            .sidebar-link {
                margin-bottom: 0;
            }

            .main-content {
                padding: 16px;
            }
        }
    </style>
</head>

<body>

<div class="app-layout">

    <!-- Felles navigasjonsmeny. -->
    <aside class="sidebar">

        <div class="sidebar-brand">
            Kriseportal
        </div>

        <nav class="sidebar-nav" aria-label="Hovedmeny">

            <!-- Lenke til forsiden. -->
            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link @(currentController == "Home" ? "active" : "")">
                Dashboard
            </a>

            <!-- Lenke til registrering av behov. -->
            <a asp-controller="Need"
               asp-action="Create"
               class="sidebar-link @(currentController == "Need" ? "active" : "")">
                Behov
            </a>

            <!-- Lenke til registrering av ressurser. -->
            <a asp-controller="Resource"
               asp-action="Create"
               class="sidebar-link @(currentController == "Resource" ? "active" : "")">
                Ressurser
            </a>

            <!-- Kart og forespørsler aktiveres når sidene er implementert. -->
            <span class="sidebar-link disabled" aria-disabled="true">
                Kart
            </span>

            <span class="sidebar-link disabled" aria-disabled="true">
                Forespørsler
            </span>

        </nav>

    </aside>

    <!-- Her vises innholdet fra den aktive siden. -->
    <main class="main-content">
        @RenderBody()
    </main>

</div>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>