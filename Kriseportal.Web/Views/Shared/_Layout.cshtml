@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kriseportalen</title>

    <!-- Inter-font -->
    <link rel="preload" href="@Url.Content("~/fonts/InterVariable.woff2")" as="font" type="font/woff2" crossorigin />
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Felles Figma-design -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- CSS for individuelle sider -->
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Sara: Visuelt uttrykk for Beredskapsportalen, uten å endre site.css. */
        .public-actor-portal {
            --bp-primary: #244D3B;
            --bp-dark: #193B2D;
            --bp-sage: #E8EFE7;
            --bp-background: #F0F3EA;
            --bp-text: #24382D;
            --bp-muted: #65766B;
            --bp-border: #DCE5DB;
            background: var(--bp-background);
            color: var(--bp-text);
            min-height: 100vh;
            font-family: 'Inter', Arial, sans-serif;
        }
        .public-actor-portal *, .public-actor-portal *::before, .public-actor-portal *::after { box-sizing: border-box; }
        .public-actor-portal .bp-header {
            height: 94px; padding: 12px 36px; background: #fff;
            border-bottom: 1px solid var(--bp-border);
            display: flex; align-items: center; justify-content: space-between; gap: 24px;
        }
        .public-actor-portal .bp-brand { display: flex; align-items: center; gap: 16px; min-width: 0; }
        .public-actor-portal .bp-brand a { display: flex; align-items: center; flex-shrink: 0; }
        .public-actor-portal .bp-logo { display: block; width: auto; max-width: 240px; max-height: 68px; object-fit: contain; }
        .public-actor-portal .bp-header-divider { height: 36px; width: 1px; background: var(--bp-border); }
        .public-actor-portal .bp-header-label { color: var(--bp-primary); font-size: 13px; font-weight: 700; }
        .public-actor-portal .bp-header-actions { display: flex; align-items: center; gap: 14px; }
        .public-actor-portal .bp-role-pill {
            display: flex; align-items: center; gap: 8px; background: #E8F2E9;
            color: var(--bp-primary); padding: 10px 15px; border-radius: 30px;
            font-size: 13px; font-weight: 600; white-space: nowrap;
        }
        .public-actor-portal .bp-user-icon {
            width: 42px; height: 42px; border-radius: 50%; background: var(--bp-primary);
            display: flex; align-items: center; justify-content: center; color: white;
            text-decoration: none;
        }
        .public-actor-portal .bp-shell { display: flex; min-height: calc(100vh - 94px); }
        .public-actor-portal .bp-sidebar {
            width: 260px; flex-shrink: 0; background: var(--bp-sage);
            border-right: 1px solid #D5E1D5; padding: 34px 18px;
            display: flex; flex-direction: column;
        }
        .public-actor-portal .bp-sidebar-heading {
            color: #7B8B7E; font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1.3px;
            padding: 0 15px; margin-bottom: 16px;
        }
        .public-actor-portal .bp-sidebar-nav, .public-actor-portal .bp-sidebar-bottom {
            display: flex; flex-direction: column; gap: 7px;
        }
        .public-actor-portal .bp-sidebar-bottom { margin-top: 8px; }
        .public-actor-portal .bp-sidebar-divider { height: 1px; background: #D1DED1; margin: 18px 12px; }
        .public-actor-portal .bp-sidebar-link {
            display: flex; align-items: center; gap: 13px; width: 100%;
            padding: 14px 15px; border: 0; border-radius: 11px;
            background: transparent; color: #425D4B; text-decoration: none;
            font-size: 14px; font-weight: 600; text-align: left;
            cursor: pointer; transition: background .2s, color .2s;
        }
        .public-actor-portal .bp-sidebar-link:hover { background: #D9E7D9; color: var(--bp-primary); }
        .public-actor-portal .bp-sidebar-link.active,
        .public-actor-portal .bp-sidebar-link.active:hover {
            background: var(--bp-primary); color: #fff;
            box-shadow: 0 4px 12px rgba(36,77,59,.12);
        }
        .public-actor-portal .bp-sidebar-link .sidebar-icon { width: 20px; height: 20px; flex-shrink: 0; }
        .public-actor-portal .bp-sidebar-link.active .sidebar-icon { filter: brightness(0) invert(1); }
        .public-actor-portal .bp-logout:hover { background: #F7E6E3; color: #A63E3E; }
        .public-actor-portal .bp-main { flex: 1; min-width: 0; }
        .public-actor-portal .bp-footer { background: var(--bp-dark); color: white; }
        .public-actor-portal .bp-footer-inner {
            display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
            padding: 40px 48px 34px;
        }
        .public-actor-portal .bp-footer h3 { color: white; font-size: 16px; font-weight: 700; margin: 0 0 15px; }
        .public-actor-portal .bp-footer p { color: #D7E5DA; font-size: 13px; line-height: 1.8; max-width: 450px; margin: 0; }
        .public-actor-portal .bp-footer-bottom {
            border-top: 1px solid rgba(255,255,255,.15); padding: 19px 48px;
            display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
            color: #C4D7CA; font-size: 12px;
        }
        .bp-logout-dialog {
            border: 0; border-radius: 18px; padding: 28px;
            width: min(94vw, 510px); max-width: 510px;
            box-shadow: 0 24px 75px rgba(20,45,30,.2);
            font-family: 'Inter', Arial, sans-serif;
        }
        .bp-logout-dialog::backdrop { background: rgba(18,38,28,.5); }
        .bp-logout-dialog h2 { color: #244D3B; font-size: 21px; font-weight: 700; margin: 0 0 14px; }
        .bp-logout-dialog p { color: #526659; font-size: 14px; line-height: 1.7; margin: 0; }
        .bp-logout-dialog-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
        .bp-logout-dialog-button { border: 0; border-radius: 10px; padding: 12px 17px; font-size: 13px; font-weight: 650; cursor: pointer; }
        .bp-logout-dialog-button.cancel { background: #244D3B; color: #fff; }
        .bp-logout-dialog-button.confirm { background: #E8EFE7; color: #244D3B; }
        .bp-logout-dialog form { margin: 0; }
        @@media (max-width: 1000px) {
            .public-actor-portal .bp-sidebar { width: 220px; }
            .public-actor-portal .bp-header { padding: 12px 22px; }
            .public-actor-portal .bp-logo { max-width: 190px; max-height: 62px; }
            .public-actor-portal .bp-footer-inner { padding: 35px 28px; gap: 25px; }
            .public-actor-portal .bp-footer-bottom { padding: 18px 28px; }
        }
        @@media (max-width: 760px) {
            .public-actor-portal .bp-header { height: auto; min-height: 82px; flex-wrap: wrap; }
            .public-actor-portal .bp-header-divider, .public-actor-portal .bp-header-label { display: none; }
            .public-actor-portal .bp-role-pill { font-size: 11px; padding: 8px 10px; }
            .public-actor-portal .bp-shell { display: block; }
            .public-actor-portal .bp-sidebar { width: 100%; padding: 15px; border-right: 0; border-bottom: 1px solid var(--bp-border); }
            .public-actor-portal .bp-sidebar-heading { display: none; }
            .public-actor-portal .bp-sidebar-nav, .public-actor-portal .bp-sidebar-bottom { flex-direction: row; flex-wrap: wrap; }
            .public-actor-portal .bp-sidebar-link { width: auto; font-size: 12px; padding: 10px; gap: 7px; }
            .public-actor-portal .bp-sidebar-link .sidebar-icon { width: 17px; height: 17px; }
            .public-actor-portal .bp-sidebar-divider { display: none; }
            .public-actor-portal .bp-footer-inner { grid-template-columns: 1fr; gap: 28px; }
        }
        @@media (max-width: 480px) {
            .public-actor-portal .bp-logo { max-width: 170px; max-height: 58px; }
            .public-actor-portal .bp-header-actions { gap: 8px; }
            .public-actor-portal .bp-user-icon { width: 36px; height: 36px; }
            .public-actor-portal .bp-footer-inner { padding: 30px 20px; }
            .public-actor-portal .bp-footer-bottom { padding: 18px 20px; }
        }
    </style>
</head>
<body>
<div class="public-actor-portal">
    <!-- Sara: Toppmeny for Beredskapsportalen. -->
    <header class="bp-header">
        <div class="bp-brand">
            <a asp-controller="Home" asp-action="Index" aria-label="Gå til oversikten">
                <img src="~/image/kriseportalen-logo.png" asp-append-version="true" alt="Kriseportalen" class="bp-logo" />
            </a>
            <span class="bp-header-divider" aria-hidden="true"></span>
            <span class="bp-header-label">Beredskapsportalen</span>
        </div>
        <div class="bp-header-actions">
            <span class="bp-role-pill">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
                Offentlig aktør
            </span>
            <a asp-controller="Profile" asp-action="Index" class="bp-user-icon" aria-label="Min profil">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            </a>
        </div>
    </header>

    <div class="bp-shell">
        <aside class="bp-sidebar">
            <div class="bp-sidebar-heading">Min portal</div>
            <!-- Hovedmeny: Beholder eksisterende controllere og actions. -->
            <nav class="bp-sidebar-nav" aria-label="Hovedmeny">
                <!-- Dashboard -->
                <a asp-controller="Home" asp-action="Index" class="bp-sidebar-link @(currentController == "Home" ? "active" : "")">
                    <img src="~/icons/dashboard.svg" alt="" class="sidebar-icon" /> Din oversikt
                </a>
                <!-- Behov -->
                <a asp-controller="Need" asp-action="Index" class="bp-sidebar-link @(currentController == "Need" ? "active" : "")">
                    <img src="~/icons/behov.svg" alt="" class="sidebar-icon" /> Behov
                </a>
                <!-- Ressurser -->
                <a asp-controller="Resource" asp-action="Index" class="bp-sidebar-link @(currentController == "Resource" ? "active" : "")">
                    <img src="~/icons/ressurser.svg" alt="" class="sidebar-icon" /> Ressurser
                </a>
                <!-- Kart: Ny funksjon fra master -->
                <a asp-controller="Map" asp-action="Index" class="bp-sidebar-link @(currentController == "Map" ? "active" : "")">
                    <img src="~/icons/kart.svg" alt="" class="sidebar-icon" /> Kart
                </a>
                <!-- Forespørsler: ID beholdes for eksisterende varselkode. -->
                <a asp-controller="Requests" asp-action="Index" class="bp-sidebar-link @(currentController == "Requests" ? "active" : "")">
                    <img src="~/icons/foresporsler.svg" alt="" class="sidebar-icon" /> Forespørsler
                    <span id="request-response-count" aria-label="Uleste svarvarsler" style="margin-left:auto; background:#A7352C; color:white; border-radius:20px; padding:2px 8px; font-weight:700;" hidden></span>
                </a>
            </nav>
            <!-- Nederste meny -->
            <div class="bp-sidebar-bottom">
                <div class="bp-sidebar-divider"></div>
                <!-- Innstillinger -->
                <a asp-controller="Settings" asp-action="Index" class="bp-sidebar-link @(currentController == "Settings" ? "active" : "")">
                    <img src="~/icons/innstillinger.svg" alt="" class="sidebar-icon" /> Innstillinger
                </a>
                <!-- Min profil -->
                <a asp-controller="Profile" asp-action="Index" class="bp-sidebar-link @(currentController == "Profile" ? "active" : "")">
                    <img src="~/icons/profil.svg" alt="" class="sidebar-icon" /> Min profil
                </a>
                <!-- Innlogging og utlogging fra master -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Sara: Ingen utlogging før bekreftelse i dialogen. -->
                    <button type="button" class="bp-sidebar-link bp-logout" onclick="document.getElementById('bp-logout-dialog').showModal()">
                        <img src="~/icons/logg-ut.svg" alt="" class="sidebar-icon" /> Logg ut
                    </button>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="bp-sidebar-link">Logg inn</a>
                    <a asp-controller="Account" asp-action="Register" class="bp-sidebar-link">Opprett konto</a>
                }
            </div>
        </aside>
        <!-- Sideinnhold -->
        <main class="bp-main">
            @RenderBody()
        </main>
    </div>

    <!-- Sara: Felles bunntekst med innhold for offentlige aktører. -->
    <footer class="bp-footer">
        <div class="bp-footer-inner">
            <section>
                <h3>Sammen styrker vi beredskapen</h3>
                <p>Beredskapsportalen hjelper offentlige aktører med å registrere behov og finne tilgjengelige ressurser når det trengs.</p>
            </section>
            <section>
                <h3>Oversikt og samhandling</h3>
                <p>Her kan du følge opp behov, se ressurser på kartet og holde oversikt over forespørsler og svar.</p>
            </section>
        </div>
        <div class="bp-footer-bottom">
            <span>© @DateTime.Now.Year Kriseportalen – Studentprosjekt</span>
            <span>Sammen styrker vi beredskapen</span>
        </div>
    </footer>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Sara: Bekreftelsesvindu før eksisterende POST-utlogging. -->
    <dialog id="bp-logout-dialog" class="bp-logout-dialog" aria-labelledby="bp-logout-title">
        <h2 id="bp-logout-title">Er du sikker på at du vil logge ut?</h2>
        <p>Du blir logget ut av Beredskapsportalen og sendt tilbake til hovedsiden.</p>
        <div class="bp-logout-dialog-actions">
            <button type="button" class="bp-logout-dialog-button cancel" onclick="document.getElementById('bp-logout-dialog').close()">Bli værende</button>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="bp-logout-dialog-button confirm">Ja, logg ut</button>
            </form>
        </div>
    </dialog>
}

@await RenderSectionAsync("Scripts", required: false)
@await Html.PartialAsync("_NotificationPopup")
</body>
</html>
