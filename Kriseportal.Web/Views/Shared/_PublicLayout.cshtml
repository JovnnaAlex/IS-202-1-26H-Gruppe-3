
@{
    // Sara: Egen layout for den offentlige forsiden.
    // De interne sidene bruker fortsatt _Layout.cshtml.
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Kriseportalen</title>

    <!-- Sara: Bootstrap for responsivt oppsett. -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Sara: Leaflet CSS til kartet på hovedforsiden. -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        /* Sara: Farger for den offentlige forsiden. */
        :root {
            --primary-green: #244D3B;
            --dark-green: #193B2D;
            --light-green: #EAF1EB;
            --background: #F8F9F6;
            --text-color: #24332B;
            --muted-text: #65736A;
            --border-color: #E1E8E1;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text-color);
            font-family: Arial, sans-serif;
        }

        /* Sara: Toppmeny. */
        .public-header {
            background: white;
            border-bottom: 1px solid var(--border-color);
        }

        .public-header-inner {
            max-width: 1200px;
            margin: auto;
            padding: 10px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .public-brand {
            display: flex;
            align-items: center;
            flex-shrink: 0;
            text-decoration: none;
            margin-left: -25px;
        }

        .public-logo {
            display: block;
            width: 260px;
            max-width: 100%;
            height: auto;
        }

        .public-nav {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 28px;
        }

        .public-nav a {
            color: var(--text-color);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .public-nav a:hover {
            color: var(--primary-green);
            text-decoration: underline;
        }

        /* Sara: Logg inn vises som en diskret knapp. */
        .public-nav .nav-login {
            border: 1px solid var(--primary-green);
            color: var(--primary-green);
            padding: 11px 19px;
            border-radius: 8px;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
        }

        .public-nav .nav-login:hover {
            background: var(--light-green);
            color: var(--dark-green);
            text-decoration: none;
        }

        /* Sara: Grønn knapp for registrering. */
        .public-nav .nav-register {
            background: var(--primary-green);
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }

        .public-nav .nav-register:hover {
            background: var(--dark-green);
            color: white;
            text-decoration: none;
        }

        /* Sara: Innholdsområdet på den offentlige forsiden. */
        .public-main {
            min-height: 65vh;
        }

        /* Sara: Bunntekst for den offentlige forsiden. */
        .public-footer {
            background: var(--dark-green);
            color: white;
        }

        .footer-inner {
            max-width: 1200px;
            margin: auto;
            padding: 60px 30px 45px;
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr;
            gap: 50px;
        }

        .footer-column h3 {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .footer-column p,
        .footer-column a {
            font-size: 14px;
            line-height: 1.8;
            color: #DFE9E1;
        }

        .footer-column a {
            display: block;
            margin-bottom: 10px;
            text-decoration: none;
        }

        .footer-column a:hover {
            color: white;
            text-decoration: underline;
        }

        /* Sara: Diskret innlogging for offentlige aktører. */
        .footer-column .footer-public-login {
            display: inline-block;
            margin-top: 8px;
            color: #DFE9E1;
            font-size: 13px;
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .footer-column .footer-public-login:hover {
            color: #FFFFFF;
            text-decoration: underline;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.18);
            text-align: center;
            padding: 22px;
            color: #D1DED4;
            font-size: 13px;
        }

        /* Sara: Mobiltilpasning. */
        @@media (max-width: 768px) {
            .public-header-inner {
                flex-direction: column;
                padding: 18px;
            }

            .public-brand {
                justify-content: center;
                margin-left: 0;
            }

            .public-logo {
                width: 230px;
            }

            .public-nav {
                justify-content: center;
                gap: 16px;
            }

            .footer-inner {
                grid-template-columns: 1fr;
                gap: 30px;
                padding: 40px 22px;
            }
        }
    </style>
</head>

<body>

    <!-- Sara: Offentlig toppmeny. -->
    <header class="public-header">
        <div class="public-header-inner">

            <!-- Sara: Beholder eksisterende logolenke. -->
            <a asp-controller="Front"
               asp-action="Index"
               class="public-brand">

                <img src="~/image/kriseportalen-logo.png"
                     asp-append-version="true"
                     alt="Kriseportalen"
                     class="public-logo" />

            </a>

            <nav class="public-nav" aria-label="Hovedmeny">

                <a href="/#om-portalen">Om portalen</a>

                <a href="/#slik-bidrar-du">Slik bidrar du</a>

                <a href="/#kontakt">Kontakt</a>

                <!-- Sara: Innlogging for ressursleverandører. -->
                <a asp-controller="Account"
                   asp-action="Login"
                   class="nav-login">
                    Logg inn
                </a>

                <!-- Sara: Registrering av ressursleverandører. -->
                <a asp-controller="Account"
                   asp-action="Register"
                   class="nav-register">
                    Opprett bruker
                </a>

            </nav>
        </div>
    </header>

    <!-- Sara: Her vises innholdet fra den aktuelle siden. -->
    <main class="public-main">
        @RenderBody()
    </main>

    <!-- Sara: Offentlig bunntekst. -->
    <footer class="public-footer" id="kontakt">
        <div class="footer-inner">

            <section class="footer-column">
                <h3>Kriseportalen</h3>

                <p>
                    En digital løsning som kobler sammen
                    ressursleverandører og offentlige aktører
                    ved behov for ekstra ressurser.
                </p>

                <p>
                    Sammen styrker vi samfunnets beredskap.
                </p>

                <!-- Sara: Diskret lenke til offentlig innlogging. -->
                <a asp-controller="Account"
                   asp-action="PublicLogin"
                   class="footer-public-login">
                    Logg inn som offentlig aktør
                </a>
            </section>

            <section class="footer-column">
                <h3>Snarveier</h3>

                <a href="/">Forside</a>
                <a href="/#om-portalen">Om Kriseportalen</a>
                <a href="/#slik-bidrar-du">Slik bidrar du</a>
            </section>

            <section class="footer-column">
                <h3>Informasjon</h3>

                <p>
                    Kriseportalen utvikles som et studentprosjekt
                    innen digital kriseberedskap.
                </p>

                <p>
                    Løsningen er under utvikling.
                </p>
            </section>

        </div>

        <div class="footer-bottom">
            © @DateTime.Now.Year Kriseportalen –
            Studentprosjekt
        </div>
    </footer>

    <!-- Sara: Leaflet JavaScript til det interaktive kartet. -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Sara: Lar hver side laste egne skript ved behov. -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
