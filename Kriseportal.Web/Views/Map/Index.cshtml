@{
    ViewData["Title"] = "Situasjonskart";
}

<!-- Leaflet sitt stilark for kartvisning -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    /* Kartsiden fyller hele skjermen ved siden av menyen */
    .app-layout {
        height: 100dvh;
        min-height: 0;
    }

    .main-content {
        padding: 0;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .crisis-map-page {
        position: relative;
        flex: 1;
        min-height: 0;
    }

    #crisis-map {
        position: absolute;
        inset: 0;
    }

    /* Statuslinje som ligger oppå kartet */
    .map-topbar {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 12px;
        z-index: 1000;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        pointer-events: none;
    }

    .map-topbar > * {
        pointer-events: auto;
    }

    .map-title {
        background: white;
        border-radius: 10px;
        padding: 10px 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        font-weight: 700;
        color: var(--primary-green);
    }

    .map-updated {
        display: block;
        font-weight: 400;
        font-size: 0.85rem;
        color: #555;
    }

    /* Knapper minst 44 piksler, så de er lette å treffe med fingeren */
    .map-button {
        min-width: 44px;
        min-height: 44px;
        padding: 0 14px;
        border: none;
        border-radius: 10px;
        background: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        font-weight: 600;
        color: var(--primary-green);
    }
</style>

<div class="crisis-map-page">
    <div id="crisis-map" role="application" aria-label="Situasjonskart over behov og ressurser"></div>

    <div class="map-topbar">
        <div class="map-title">
            Situasjonskart
            <span class="map-updated" id="map-updated">Henter data …</span>
        </div>
        <button type="button" class="map-button" id="map-refresh">Oppdater</button>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/crisis-map.js" asp-append-version="true"></script>
}