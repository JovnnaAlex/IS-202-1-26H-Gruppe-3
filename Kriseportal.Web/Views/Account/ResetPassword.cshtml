@model Kriseportal.Web.Models.ResetPasswordViewModel

@{
    // Glemt passord: brukeren velger nytt passord fra lenken.
    Layout = "_PublicLayout";
    ViewData["Title"] = "Nytt passord";
    var loginAction = Model.PublicAuthority ? "PublicLogin" : "Login";
}

<link rel="stylesheet" href="~/css/password-reset.css" asp-append-version="true" />

<section class="pr-section">
    <div class="pr-card">

        <div class="pr-heading">
            <h1 class="pr-title">Lag nytt passord</h1>
            <p class="pr-description">
                Velg et nytt passord for kontoen din.
            </p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post">

            <div asp-validation-summary="ModelOnly" class="pr-validation-summary"></div>

            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="PublicAuthority" />

            <div class="pr-field">
                <label asp-for="Email" class="pr-label">E-postadresse</label>
                <input asp-for="Email"
                       type="email"
                       class="pr-input"
                       readonly
                       autocomplete="username" />
            </div>

            <div class="pr-field">
                <label asp-for="Password" class="pr-label">Nytt passord</label>
                <input asp-for="Password"
                       type="password"
                       class="pr-input"
                       placeholder="Skriv inn nytt passord"
                       autocomplete="new-password" />
                <p class="pr-hint">
                    Minst 6 tegn, med stor og liten bokstav, tall og spesialtegn.
                </p>
                <span asp-validation-for="Password" class="pr-validation"></span>
            </div>

            <div class="pr-field">
                <label asp-for="ConfirmPassword" class="pr-label">Gjenta nytt passord</label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="pr-input"
                       placeholder="Skriv passordet en gang til"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="pr-validation"></span>
            </div>

            <button type="submit" class="pr-button">Lagre nytt passord</button>
        </form>

        <a asp-controller="Account" asp-action="@loginAction" class="pr-back">
            Tilbake til innlogging
        </a>

    </div>
</section>
