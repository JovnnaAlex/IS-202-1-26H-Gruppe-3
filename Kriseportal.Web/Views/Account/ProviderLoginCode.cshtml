@model Kriseportal.Web.Models.AuthenticatorCodeViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Bekreft innlogging";
}

<partial name="_PublicLoginStyles" />

<section class="public-login-section">
    <div class="public-login-card">
        <h1 class="public-login-title">Bekreft innlogging</h1>
        <p class="public-login-description">
            Skriv inn den sekssifrede koden fra autentiseringsappen.
        </p>

        <form asp-controller="Account" asp-action="ProviderLoginCode" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="public-login-validation-summary"></div>

            <label asp-for="Code" class="public-login-label"></label>
            <input asp-for="Code" type="text" inputmode="numeric"
                   autocomplete="one-time-code" maxlength="6" class="public-login-input" />
            <span asp-validation-for="Code" class="public-login-validation"></span>

            <button type="submit" class="public-login-button">
                Bekreft og logg inn
            </button>
        </form>

        <hr class="public-login-divider" />

        <a asp-controller="Account" asp-action="Login" class="public-login-back">
            Tilbake til innlogging
        </a>
    </div>
</section>