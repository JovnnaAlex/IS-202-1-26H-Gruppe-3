@{
    // Glemt passord: bekrefter at passordet er endret.
    Layout = "_PublicLayout";
    ViewData["Title"] = "Passordet er endret";
    var publicAuthority = ViewData["PublicAuthority"] as bool? ?? false;
    var loginAction = publicAuthority ? "PublicLogin" : "Login";
}

<link rel="stylesheet" href="~/css/password-reset.css" asp-append-version="true" />

<section class="pr-section">
    <div class="pr-card" role="status">

        <div class="pr-heading">
            <h1 class="pr-title">Passordet er endret</h1>
            <p class="pr-description">
                Du kan nå logge inn med det nye passordet ditt.
            </p>
        </div>

        <a asp-controller="Account" asp-action="@loginAction" class="pr-button">
            Logg inn
        </a>

    </div>
</section>
