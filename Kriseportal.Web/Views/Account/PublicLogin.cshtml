
@model Kriseportal.Web.Models.LoginViewModel

@{
    // Sara: Bruker offentlig layout for innlogging til offentlige aktører.
    Layout = "_PublicLayout";
    ViewData["Title"] = "Innlogging for offentlig aktør";
}

<style>
    /* Sara: Samme bakgrunn og kortdesign som vanlig innlogging. */
    .public-login-section {
        min-height: 75vh;
        background: #F0F3EA;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
    }

    .public-login-card {
        width: 100%;
        max-width: 470px;
        background: #FFFFFF;
        border: 1px solid #E2E8DE;
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 12px 35px rgba(36, 77, 59, 0.07);
    }

    .public-login-heading {
        text-align: center;
        margin-bottom: 35px;
    }

    .public-login-title {
        color: #244D3B;
        font-size: 29px;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 12px;
    }

    .public-login-description {
        color: #53645A;
        font-size: 15px;
        line-height: 1.7;
        margin: 0;
    }

    /* Sara: Skjemafelter for e-post og passord. */
    .public-login-field {
        margin-bottom: 22px;
    }

    .public-login-label {
        display: block;
        color: #244D3B;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .public-login-input {
        display: block;
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #D8E2D7;
        border-radius: 9px;
        background: #FFFFFF;
        color: #244D3B;
        font-size: 15px;
    }

    .public-login-input:focus {
        outline: none;
        border-color: #244D3B;
        box-shadow: 0 0 0 3px rgba(36, 77, 59, 0.10);
    }

    .public-login-input::placeholder {
        color: #98A69B;
    }

    /* Sara: Innloggingsknapp. */
    .public-login-button {
        width: 100%;
        background: #244D3B;
        color: #FFFFFF;
        border: none;
        border-radius: 9px;
        padding: 15px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
    }

    .public-login-button:hover {
        background: #193B2D;
    }

    /* Sara: Informasjon om tilgang og tilbake-lenke. */
    .public-login-info {
        margin-top: 25px;
        text-align: center;
        color: #53645A;
        font-size: 13px;
        line-height: 1.7;
    }

    .public-login-divider {
        border: none;
        border-top: 1px solid #E2E8DE;
        margin: 25px 0;
        opacity: 1;
    }

    .public-login-back {
        display: block;
        color: #244D3B;
        font-size: 14px;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-align: center;
    }

    .public-login-back:hover {
        color: #193B2D;
    }

    /* Sara: Viser valideringsfeil fra ASP.NET. */
    .public-login-validation {
        color: #B42318;
        font-size: 13px;
        margin-top: 7px;
        display: block;
    }

    .public-login-validation-summary {
        color: #B42318;
        font-size: 14px;
        margin-bottom: 18px;
    }

    /* Sara: Tilpasning for mobil. */
    @@media (max-width: 600px) {
        .public-login-section {
            padding: 50px 18px;
        }

        .public-login-card {
            padding: 32px 24px;
        }

        .public-login-title {
            font-size: 25px;
        }
    }
</style>

<!-- Sara: Innloggingsside for offentlige aktører. -->
<section class="public-login-section">

    <div class="public-login-card">

        <div class="public-login-heading">

            <h1 class="public-login-title">
                Innlogging for offentlig aktør
            </h1>

            <p class="public-login-description">
                Logg inn med din godkjente brukerkonto
                for å få tilgang til Kriseportalens
                beredskapsoversikt.
            </p>

        </div>

        <!-- Sara: Skjemaet kobles til egen innloggingshandling senere. -->
        <form asp-controller="Account"
              asp-action="PublicLogin"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="public-login-validation-summary">
            </div>

            <div class="public-login-field">

                <label asp-for="Email" class="public-login-label">
                    E-postadresse
                </label>

                <input asp-for="Email"
                       type="email"
                       class="public-login-input"
                       placeholder="Skriv inn e-postadressen din"
                       autocomplete="username" />

                <span asp-validation-for="Email"
                      class="public-login-validation"></span>

            </div>

            <div class="public-login-field">

                <label asp-for="Password" class="public-login-label">
                    Passord
                </label>

                <input asp-for="Password"
                       type="password"
                       class="public-login-input"
                       placeholder="Skriv inn passordet ditt"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"
                      class="public-login-validation"></span>

            </div>

            <button type="submit" class="public-login-button">
                Logg inn
            </button>

        </form>

        <p class="public-login-info">
            Kun for autoriserte offentlige aktører.
        </p>

        <hr class="public-login-divider" />

        <!-- Sara: Tilbake til vanlig innlogging ved feil valg. -->
        <a asp-controller="Account"
           asp-action="Login"
           class="public-login-back">
            Tilbake til vanlig innlogging
        </a>

    </div>

</section>
