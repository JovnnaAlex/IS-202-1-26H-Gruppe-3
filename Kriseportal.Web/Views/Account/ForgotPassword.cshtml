@model Kriseportal.Web.Models.ForgotPasswordViewModel

@{
    // Glemt passord: brukeren skriver inn e-postadressen sin og får en lenke.
    Layout = "_PublicLayout";
    ViewData["Title"] = "Glemt passord";
    var loginAction = Model.PublicAuthority ? "PublicLogin" : "Login";
}

<link rel="stylesheet" href="~/css/password-reset.css" asp-append-version="true" />

<section class="pr-section">
    <div class="pr-card">

        <div class="pr-heading">
            <h1 class="pr-title">Glemt passord?</h1>
            <p class="pr-description">
                Skriv inn e-postadressen du logger inn med.
                Hvis den er registrert, får du en lenke for å lage et nytt passord.
            </p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">

            <div asp-validation-summary="ModelOnly" class="pr-validation-summary"></div>

            <input type="hidden" asp-for="PublicAuthority" />

            <div class="pr-field">
                <label asp-for="Email" class="pr-label">E-postadresse</label>
                <input asp-for="Email"
                       type="email"
                       class="pr-input"
                       placeholder="Skriv inn e-postadressen din"
                       autocomplete="username" />
                <span asp-validation-for="Email" class="pr-validation"></span>
            </div>

            <button type="submit" class="pr-button">Send lenke</button>
        </form>

        <a asp-controller="Account" asp-action="@loginAction" class="pr-back">
            Tilbake til innlogging
        </a>

    </div>
</section>
