@{
    // Glemt passord: samme melding uansett om e-postadressen finnes.
    Layout = "_PublicLayout";
    ViewData["Title"] = "Sjekk e-posten din";
    var publicAuthority = ViewData["PublicAuthority"] as bool? ?? false;
    var loginAction = publicAuthority ? "PublicLogin" : "Login";
}

<link rel="stylesheet" href="~/css/password-reset.css" asp-append-version="true" />

<section class="pr-section">
    <div class="pr-card" role="status">

        <div class="pr-heading">
            <h1 class="pr-title">Sjekk e-posten din</h1>
            <p class="pr-description">
                Hvis e-postadressen er registrert hos oss, har vi sendt en lenke
                for å lage et nytt passord. Lenken varer i én time.
            </p>
        </div>

        @* Bare under utvikling: appen sender ikke e-post ennå, så lenken vises her *@
        @if (TempData["DevResetLink"] is string devResetLink)
        {
            <div class="pr-dev-box">
                <strong>Utviklingsmodus:</strong> appen sender ikke e-post ennå.
                Bruk denne lenken for å teste:<br />
                <a href="@devResetLink">@devResetLink</a>
            </div>
        }

        <a asp-controller="Account" asp-action="@loginAction" class="pr-back">
            Tilbake til innlogging
        </a>

    </div>
</section>
