@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <!-- Emma: levende dashbordkart -->
    <link rel="stylesheet"
          href="~/css/dashboard-map.css"
          asp-append-version="true" />
}

<div class="dashboard-page">

    <!-- Sideoverskrift -->
    <header class="dashboard-header">

        <div>
            <h1>Dashboard</h1>
            <p>Oversikt over behov og ressurser</p>
        </div>

        <!-- Knapp for å registrere behov -->
        <a asp-controller="Need"
           asp-action="Create"
           class="dashboard-create-button">
            + Registrer behov
        </a>

    </header>

    <!-- Kart og oversiktskort -->
    <main class="dashboard-content">

        <!-- Kartet til venstre -->
        <section class="dashboard-map-section"
                 aria-label="Kartoversikt">

            <h2 class="dashboard-visually-hidden">
                Kartoversikt
            </h2>

            <div id="dashboardMap"
                 aria-label="Kart over behov og ressurser">
            </div>

        </section>

        <!-- Oversiktskort til høyre -->
        <section class="dashboard-statistics"
                 aria-label="Statusoversikt">

            <!-- Aktive behov - klikkbart kort -->
            <a asp-controller="Need"
               asp-action="Index"
               class="dashboard-summary-card dashboard-summary-link">

                <div class="dashboard-summary-top">
                    <h2>Aktive behov</h2>

                    <span class="dashboard-summary-icon">
                        !
                    </span>
                </div>

                <p class="dashboard-summary-number" id="dash-needs">—</p>

                <p class="dashboard-summary-description">
                    <span class="dm-acute-count">Akutte: <span id="dash-acute">0</span></span>
                    · behov som ikke er løst
                </p>

            </a>

            <!-- Ressurser - klikkbart kort -->
            <a asp-controller="Resource"
               asp-action="Index"
               class="dashboard-summary-card dashboard-summary-link">

                <div class="dashboard-summary-top">
                    <h2>Tilgjengelige ressurser</h2>

                    <span class="dashboard-summary-icon">
                        ✓
                    </span>
                </div>

                <p class="dashboard-summary-number" id="dash-resources">—</p>

                <p class="dashboard-summary-description">
                    Ressurser tilgjengelig for bruk
                </p>

            </a>

            <!-- Forespørsler - klikkbart kort -->
            <a asp-controller="Requests"
               asp-action="Index"
               class="dashboard-summary-card dashboard-summary-link">

                <div class="dashboard-summary-top">
                    <h2>Forespørsler</h2>

                    <span class="dashboard-summary-icon">
                        ↗
                    </span>
                </div>

                <p class="dashboard-summary-number">—</p>

                <p class="dashboard-summary-description">
                    Forespørsler i systemet
                </p>

            </a>

        </section>

    </main>

    <!-- Forklaring for testversjonen -->
    <p class="dashboard-note">
        Kartet og tallene oppdateres automatisk hvert 15. sekund.
        Trykk på kartet for å åpne situasjonskartet.
    </p>

</div>

@section Scripts {

    <!-- Leaflet JavaScript -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Emma: levende dashbordkart med data fra /Map/Data -->
    <script src="~/js/dashboard-map.js" asp-append-version="true"></script>
}
