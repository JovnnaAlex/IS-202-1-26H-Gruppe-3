@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
}

<div class="dashboard-page">

    <!-- Sideoverskrift -->
    <header class="dashboard-header">

        <div>
            <h1>Dashboard</h1>
            <p>Oversikt over behov og ressurser</p>
        </div>

        <!-- Knapp for å registrere behov -->
        <a asp-controller="Need"
           asp-action="Create"
           class="dashboard-create-button">
            + Registrer behov
        </a>

    </header>

    <!-- Kart og oversiktskort -->
    <main class="dashboard-content">

        <!-- Kartet til venstre -->
        <section class="dashboard-map-section"
                 aria-label="Kartoversikt">

            <h2 class="dashboard-visually-hidden">
                Kartoversikt
            </h2>

            <div id="dashboardMap"
                 aria-label="Kart over behov og ressurser">
            </div>

        </section>

        <!-- Oversiktskort til høyre -->
        <section class="dashboard-statistics"
                 aria-label="Statusoversikt">

            <!-- Aktive behov - klikkbart kort -->
            <a asp-controller="Need"
               asp-action="Index"
               class="dashboard-summary-card dashboard-summary-link">

                <div class="dashboard-summary-top">
                    <h2>Aktive behov</h2>

                    <span class="dashboard-summary-icon">
                        !
                    </span>
                </div>

                <p class="dashboard-summary-number">—</p>

                <p class="dashboard-summary-description">
                    Registrerte behov i systemet
                </p>

            </a>

            <!-- Ressurser - klikkbart kort -->
            <a asp-controller="Resource"
               asp-action="Create"
               class="dashboard-summary-card dashboard-summary-link">

                <div class="dashboard-summary-top">
                    <h2>Tilgjengelige ressurser</h2>

                    <span class="dashboard-summary-icon">
                        ✓
                    </span>
                </div>

                <p class="dashboard-summary-number">—</p>

                <p class="dashboard-summary-description">
                    Ressurser tilgjengelig for bruk
                </p>

            </a>

            <!-- Forespørsler - klikkbart kort -->
            <a asp-controller="Request"
               asp-action="Index"
               class="dashboard-summary-card dashboard-summary-link">

                <div class="dashboard-summary-top">
                    <h2>Forespørsler</h2>

                    <span class="dashboard-summary-icon">
                        ↗
                    </span>
                </div>

                <p class="dashboard-summary-number">—</p>

                <p class="dashboard-summary-description">
                    Forespørsler i systemet
                </p>

            </a>

        </section>

    </main>

    <!-- Forklaring for testversjonen -->
    <p class="dashboard-note">
        Oversiktstall og kartmarkører vises når løsningen
        er koblet til databasen.
    </p>

</div>

@section Scripts {

    <!-- Leaflet JavaScript -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Dashboard-kart sentrert på Kristiansand
        const dashboardMap = L.map("dashboardMap").setView(
            [58.1467, 7.9956],
            11
        );

        // Kartgrunnlag fra Kartverket
        L.tileLayer(
            "https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png",
            {
                maxZoom: 18,
                attribution: "&copy; Kartverket"
            }
        ).addTo(dashboardMap);

        // Oppdaterer kartstørrelse etter innlasting
        window.addEventListener("load", function () {
            dashboardMap.invalidateSize();
        });
    </script>
}
